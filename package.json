{
	"name": "sapin",
	"private": true,
	"version": "0.99.1",
	"type": "module",
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/copy-server.mjs",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose down && docker compose up -d",
		"docker:clean": "docker compose down -v --remove-orphans",
		"docker:logs": "docker compose logs -f sapin",
		"docker:ps": "docker compose ps",
		"docker:secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
		"docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
		"docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
		"docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f sapin",
		"docker:prod:ps": "docker compose -f docker-compose.prod.yml --env-file .env.production ps",
		"docker:prod:pull": "docker compose -f docker-compose.prod.yml --env-file .env.production pull",
		"docker:prod:update": "docker compose -f docker-compose.prod.yml --env-file .env.production pull && docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
		"docker:qdrant:debug:up": "docker compose -f docker-compose.yml -f docker-compose.qdrant-debug.yml up -d",
		"docker:qdrant:debug:down": "docker compose -f docker-compose.yml -f docker-compose.qdrant-debug.yml down",
		"preview": "vite preview",
		"test": "node --import ./scripts/node-test-register.mjs --test \"src/**/*.test.ts\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:backfill-agent-ui-components": "npx tsx scripts/backfill-agent-ui-components.ts",
		"machine-translate": "inlang machine translate --project project.inlang",
		"test:e2e": "playwright test",
		"test:integration:live": "node --import ./scripts/node-test-register.mjs scripts/integration-smoke.ts --live"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@inlang/cli": "^3.3.9",
		"@inlang/paraglide-js": "^2.26.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/diacritics": "^1.3.3",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-zod": "^0.8.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^7.3.7",
		"vite-plugin-devtools-json": "^1.1.1"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.124",
		"@ai-sdk/openai-compatible": "^2.0.81",
		"@ai-sdk/svelte": "^4.0.302",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@node-rs/argon2": "^2.2.2",
		"@openrouter/ai-sdk-provider": "^2.10.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@qdrant/js-client-rest": "~1.18.0",
		"@rod2ik/tikzjax": "^1.0.0-beta32",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "3.31.4",
		"@tiptap/extension-highlight": "3.31.4",
		"@tiptap/extension-image": "3.31.4",
		"@tiptap/extension-link": "3.31.4",
		"@tiptap/extension-placeholder": "3.31.4",
		"@tiptap/extension-text-align": "3.31.4",
		"@tiptap/extension-typography": "3.31.4",
		"@tiptap/extension-underline": "3.31.4",
		"@tiptap/markdown": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/starter-kit": "3.31.4",
		"@types/bcrypt": "^6.0.0",
		"@types/file-saver": "^2.0.7",
		"@types/node-cron": "^3.0.11",
		"@types/pdf-parse": "^1.1.5",
		"@xyflow/svelte": "^1.7.0",
		"@zip.js/zip.js": "^2.23.0",
		"ai": "^6.0.302",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.11.1",
		"csv-parse": "^6.2.1",
		"diacritics": "^1.3.0",
		"docx": "^9.9.0",
		"drizzle-orm": "^0.45.3",
		"echarts": "^6.1.0",
		"express": "^5.2.1",
		"file-saver": "^2.0.5",
		"handlebars": "^4.7.10",
		"isomorphic-dompurify": "2.26.0",
		"jsxgraph": "^1.14.0",
		"katex": "^0.16.47",
		"lucide-svelte": "^0.563.0",
		"mammoth": "^1.13.0",
		"marked": "^17.0.6",
		"marked-katex-extension": "^5.1.13",
		"node-cron": "^4.6.0",
		"node-tikzjax": "^1.0.5",
		"nodemailer": "^10.0.16",
		"openai": "^6.49.0",
		"pdf-parse": "^2.4.5",
		"pino": "^10.4.0",
		"sharp": "^0.35.5",
		"zod": "^4.6.5"
	}
}
